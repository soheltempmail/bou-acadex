# Backend (Next.js) environment
# Port used by `next dev` / `next start` (default 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Frontend (static HTML/CSS/JS)
# Base URL the browser uses to reach the backend API.
# Override at runtime by setting window.BOU_API_BASE before js/api.js loads.
BOU_API_BASE=http://localhost:3000/api

# Port used by the static frontend dev server (frontend/server.js)
FRONTEND_PORT=5500
